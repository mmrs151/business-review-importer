<?xml version="1.0"?>
<ruleset name="Business Review Importer">
	<description>WordPress coding standards for Business Review Importer</description>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<file>.</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="business-review-importer"/>
		</properties>
	</rule>
</ruleset>
