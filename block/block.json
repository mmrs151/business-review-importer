{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "business-review-importer/reviews",
	"title": "Business Review Importer",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Display Trustpilot reviews as a responsive carousel, grid, or review wall.",
	"textdomain": "business-review-importer",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Customer reviews"
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"layout": {
			"type": "string",
			"default": "carousel"
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"interval": {
			"type": "number",
			"default": 5500
		},
		"fullPage": {
			"type": "boolean",
			"default": false
		},
		"minRating": {
			"type": "number",
			"default": 1
		},
		"featuredFirst": {
			"type": "boolean",
			"default": true
		},
		"gridRows": {
			"type": "number",
			"default": 3
		},
		"gridColumns": {
			"type": "number",
			"default": 3
		},
		"wallStyle": {
			"type": "string",
			"default": "standard"
		},
		"carouselVisible": {
			"type": "number",
			"default": 1
		},
		"orientation": {
			"type": "string",
			"default": "vertical"
		}
	},
	"editorScript": "bri-block",
	"style": "bri-frontend"
}
